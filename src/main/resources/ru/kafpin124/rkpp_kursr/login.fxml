<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane minHeight="220.0" minWidth="400.0" stylesheets="@styles/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kafpin124.rkpp_kursr.controller.LoginController">

    <children>
        <VBox spacing="8" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="%login.label.language" />
                <ComboBox fx:id="languageCombo" />
            </HBox>

            <HBox spacing="5">
                <Label fx:id="lbLogin" text="%login.label.login" />
                <TextField fx:id="loginField" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox spacing="5">
                <Label fx:id="lbPassword" text="%login.label.password" />
                <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS" />
            </HBox>

            <Label fx:id="messageLabel" text="" textFill="red" />

            <Separator />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <RadioButton fx:id="rbBCrypt" selected="true" text="%login.radio.bcrypt">
                    <toggleGroup>
                        <ToggleGroup fx:id="authModeGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="rbDB" text="%login.radio.db" toggleGroup="$authModeGroup" />
            </HBox>
        </VBox>

        <ButtonBar AnchorPane.bottomAnchor="5" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <buttons>
                <Button fx:id="btnClose" text="%login.button.close" />
                <Button fx:id="btnLogin" defaultButton="true" text="%login.button.login" />
            </buttons>
        </ButtonBar>
    </children>
</AnchorPane>
