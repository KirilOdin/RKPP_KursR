<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kafpin124.rkpp_kursr.contoller.MainTabController">

    <top>
        <MenuBar>
            <Menu text="Файл">
                <MenuItem onAction="#onRefresh" text="Обновить" />
                <SeparatorMenuItem />
                <MenuItem onAction="#onLogout" text="Выйти" />
            </Menu>
            <Menu text="Действия">
                <MenuItem onAction="#onSetInProgress" text="Взять в работу" />
                <MenuItem onAction="#onPrintReport" text="Печать бланка" />
            </Menu>
            <Menu text="Сервис">
                <MenuItem onAction="#onSwitchToEmployees" text="Управление сотрудниками" />
                <MenuItem onAction="#onSwitchToTests" text="Справочник анализов" />
            </Menu>
        </MenuBar>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="ordersTab" closable="false" text="%m.tab.ordersTab">
                    <fx:include source="orders_list.fxml" />
                </Tab>
                <Tab fx:id="newOrderTab" closable="false" text="%m.tab.newOrderTab">
                    <fx:include source="new_order.fxml" />
                </Tab>
                <Tab fx:id="resultsTab" closable="false" text="%m.tab.resultsTab">
                    <fx:include source="new_result.fxml" />
                </Tab>
                <Tab fx:id="verificationTab" closable="false" text="%m.tab.verificationTab">
                    <fx:include source="verification.fxml" />
                </Tab>
                <Tab fx:id="reportsTab" closable="false" text="%m.tab.reportsTab">
                    <fx:include source="reports.fxml" />
                </Tab>
                <Tab fx:id="employeesTab" closable="false" text="%m.tab.employeesTab">
                    <fx:include source="manage_employees.fxml" />
                </Tab>
                <Tab fx:id="testsTab" closable="false" text="%m.tab.testsTab">
                    <fx:include source="manage_tests.fxml" />
                </Tab>
            </tabs>
        </TabPane>
    </center>


    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Button fx:id="btUpdate" onAction="#onRefresh" text="Обновить" />
            <Button fx:id="btGetOnWork" onAction="#onSetInProgress" text="Взять в работу" />
            <Button fx:id="btShowResult" onAction="#onEnterResults" text="Результаты" />
            <Button onAction="#onPrintReport" text="Печать бланка" />
        </HBox>
    </bottom>
</BorderPane>
