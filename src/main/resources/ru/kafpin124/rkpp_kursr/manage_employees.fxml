<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="550.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kafpin124.rkpp_kursr.contoller.ManageEmployeesController">

    <center>
        <TableView fx:id="employeesTable">
            <columns>
                <TableColumn fx:id="colId" prefWidth="40" text="%manEmployee.employeesTable.colId" />
                <TableColumn fx:id="colLastName" prefWidth="100" text="%manEmployee.employeesTable.colLastName" />
                <TableColumn fx:id="colFirstName" prefWidth="100" text="%manEmployee.employeesTable.colFirstName" />
                <TableColumn fx:id="colMiddleName" prefWidth="120" text="%manEmployee.employeesTable.colMiddleName" />
                <TableColumn fx:id="colPosition" prefWidth="120" text="%manEmployee.employeesTable.colPosition" />
                <TableColumn fx:id="colRole" prefWidth="100" text="%manEmployee.employeesTable.colRole" />
            </columns>
        </TableView>
    </center>

    <right>
        <VBox prefWidth="200" spacing="10" style="-fx-padding: 10;">
            <Button fx:id="btAddEmployee" maxWidth="Infinity" onAction="#onAddEmployee" text="%manEmployee.button.btAddEmployee" />
            <Button fx:id="btEditEmployee" maxWidth="Infinity" onAction="#onEditEmployee" text="%manEmployee.button.btEditEmployee" />
            <Button fx:id="btDeleteEmployee" maxWidth="Infinity" onAction="#onDeleteEmployee" text="%manEmployee.button.btDeleteEmployee" />
        </VBox>
    </right>
</BorderPane>
