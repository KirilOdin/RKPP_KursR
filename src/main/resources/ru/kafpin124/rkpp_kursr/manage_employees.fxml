<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="550.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kafpin124.rkpp_kursr.contoller.ManageEmployeesController">

    <center>
        <TableView fx:id="employeesTable">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                <TableColumn fx:id="colLastName" text="Фамилия" prefWidth="100"/>
                <TableColumn fx:id="colFirstName" text="Имя" prefWidth="100"/>
                <TableColumn fx:id="colMiddleName" text="Отчество" prefWidth="120"/>
                <TableColumn fx:id="colPosition" text="Должность" prefWidth="120"/>
                <TableColumn fx:id="colRole" text="Роль" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="10" style="-fx-padding: 10;" prefWidth="200">
            <Button text="Добавить" onAction="#onAddEmployee" maxWidth="Infinity"/>
            <Button text="Редактировать" onAction="#onEditEmployee" maxWidth="Infinity"/>
            <Button text="Удалить" onAction="#onDeleteEmployee" maxWidth="Infinity"/>
        </VBox>
    </right>
</BorderPane>