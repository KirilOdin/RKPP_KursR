<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="500.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kafpin124.rkpp_kursr.controller.SelectTestController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
            <Label fx:id="lbFilter" text="%selectTest.label.filter"/>
            <ComboBox fx:id="filterCombo" promptText="Все"/>
            <Button fx:id="btFilter" text="%selectTest.button.show" onAction="#onFilter"/>
        </HBox>
    </top>

    <center>
        <ListView fx:id="testListView"/>
    </center>

    <bottom>
        <ButtonBar style="-fx-padding: 10;">
            <buttons>
                <Button fx:id="btAddSelected" text="%selectTest.button.addSelected" onAction="#onAddSelected"/>
                <Button fx:id="btCancel" text="%selectTest.button.cancel" onAction="#onCancel"/>
            </buttons>
        </ButtonBar>
    </bottom>
</BorderPane>