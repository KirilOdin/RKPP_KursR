<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="500.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kafpin124.rkpp_kursr.contoller.SelectTestController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
            <Label text="Фильтр по типу:"/>
            <ComboBox fx:id="filterCombo" promptText="Все"/>
            <Button text="Показать" onAction="#onFilter"/>
        </HBox>
    </top>

    <center>
        <ListView fx:id="testListView"/>
    </center>

    <bottom>
        <ButtonBar style="-fx-padding: 10;">
            <buttons>
                <Button text="Добавить выбранные" onAction="#onAddSelected"/>
                <Button text="Отмена" onAction="#onCancel"/>
            </buttons>
        </ButtonBar>
    </bottom>
</BorderPane>